{
    "name": "safesploit/doogle",
    "description": "A PHP/MySQL search engine and crawler modernised with DevSecOps practices.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Doogle\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doogle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "analyse": "phpstan analyse ./app ./assets ./classes",
        "test": "phpunit --configuration phpunit.xml"
    }
}
